{
  "name": "@refract/admin",
  "version": "0.5.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy globalVariable localStorage cookie custom-browser baseLocale --output-structure locale-modules",
    "dev": "vp dev",
    "build": "pnpm paraglide && vp check && vue-tsc --build && vp build",
    "preview": "vp preview",
    "test:unit": "pnpm paraglide && vp test",
    "test:e2e": "playwright test",
    "check": "pnpm paraglide && vp check && vue-tsc --build",
    "lint": "vp lint",
    "format": "vp fmt"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.26.0",
    "@lucide/vue": "^1.53.0",
    "@refract/contracts": "workspace:*",
    "effect": "4.0.2",
    "pinia": "^4.0.3",
    "reka-ui": "^2.11.0",
    "vue": "~3.6.0-rc.10",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "eslint-plugin-playwright": "^2.12.1",
    "jiti": "^2.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "catalog:",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plus": "catalog:",
    "vue-tsc": "^3.3.12"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
