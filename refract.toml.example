# Refract 配置模板。
#
# 用法：复制为 refract.toml 放在运行目录，按需修改。
# 所有字段都可以用环境变量覆盖（优先级更高，方便容器部署）：
#   REFRACT_LISTEN=0.0.0.0:3939 REFRACT_DATABASE=/data/refract.db ./refract-server

# 监听地址。默认只听本机 —— 网关持有全部上游密钥，把它直接暴露到
# 局域网/公网之前请先想清楚，并务必设置管理令牌。
listen = "127.0.0.1:3939"

# SQLite 数据库文件路径（相对运行目录）。
database = "refract.db"

# 是否要求客户端调用 /v1 网关接口时携带网关 API 密钥。
# 个人本机使用可以关掉；只要端口不是只听 127.0.0.1，就强烈建议打开。
require_auth = false

# 可选：启动时设置或轮换管理 API 令牌。服务只保存 SHA-256 哈希。
# 容器首次以 0.0.0.0 监听时，必须同时设置此项与 require_auth=true。
# 更推荐通过 REFRACT_ADMIN_TOKEN 环境变量注入，避免明文写入配置文件。
# admin_token = "replace-with-a-long-random-secret"

# 可选：渠道凭据静态加密主密钥（32 字节随机值的 base64 编码，如 `openssl rand -base64 32`）。
# 配置后新保存的渠道密钥在 SQLite 内以 AES-256-GCM 密文存储；留空则保持明文。
# 更推荐通过 REFRACT_MASTER_KEY 环境变量注入。
# master_key = "replace-with-a-base64-encoded-32-byte-secret"

# 上游请求整体超时（秒），只约束非流式请求。LLM 的非流式请求可能很慢，不要设太小。
upstream_timeout_secs = 300

# 流式请求的空闲超时（秒）：等待响应头的上限，以及两个数据帧之间的最大间隔。
# 流式请求不受整体超时限制 —— 一次长回答合法地跑几分钟。
stream_idle_timeout_secs = 120

# 优雅关闭窗口（秒）：收到退出信号后等待存量请求（含长流式）完成的时长，
# 超时后强制断开。容器编排的终止宽限期要不小于这个值。
shutdown_grace_secs = 30

# 出站代理，形如 "http://127.0.0.1:7890" 或 "socks5://127.0.0.1:1080"。
# 留空或不写则直连。
# proxy = "http://127.0.0.1:7890"
