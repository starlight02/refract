REFRACT_LOG=info

# 渠道密钥静态加密主密钥：32 字节随机值的 base64 编码，例如 `openssl rand -base64 32`。
# 配置后新保存的渠道密钥在 SQLite 内以 AES-256-GCM 加密存储；留空则保持明文（兼容旧部署）。
# 警告：主密钥丢失且无备份时，已加密的渠道密钥不可恢复，需全部重新录入。
# REFRACT_MASTER_KEY=

# TLS：PEM 证书与私钥必须成对配置。启用后同一地址 TCP 改为 HTTPS（HTTP/1.1+HTTP/2），UDP 听 HTTP/3。
# REFRACT_TLS_CERT=/data/cert.pem
# REFRACT_TLS_KEY=/data/key.pem

# 开放注册的邮件外发。启动时显式设置的 REFRACT_SMTP_URL / REFRACT_MAIL_FROM
# 会在装配 AppState 之前写入 settings。未配置时验证码/重置码写入服务日志。
# REFRACT_SMTP_URL=smtp://user:pass@smtp.example.com:587
# REFRACT_MAIL_FROM=Refract <noreply@example.com>

# 开发模式：验证码走 log，并开放 GET /api/auth/dev-codes?email=... 测试钩子。
# 生产环境严禁开启。
# 注意：必须是布尔值 true/false，写 1 会导致启动时配置解析失败。
# REFRACT_DEV_MODE=true
